# Backend (FastAPI). Copy to .env for local overrides, or set these in Vercel → Settings → Environment Variables.

# Postgres connection string (e.g. Neon). Without it: local SQLite file (wildfern.db) in development,
# and a TEMPORARY SQLite database on Vercel that is wiped whenever the function restarts.
DATABASE_URL=

# Owner password for the dashboard at /admin (also accepted as "Authorization: Bearer <token>" by the
# admin API). The dashboard is disabled when empty.
ADMIN_TOKEN=

# Signs the QR codes on guests' booking passes. Falls back to ADMIN_TOKEN, but set it separately so
# changing the owner password doesn't invalidate passes guests already have.
PASS_SECRET=

# Timezone used for "today" and opening-hour checks.
CAFE_TIMEZONE=UTC

# Optional email (https://resend.com, free tier). Nothing is sent unless RESEND_API_KEY is set.
RESEND_API_KEY=
# Where new-booking / cancellation alerts go (the owner's inbox).
NOTIFY_EMAIL=
# Sender. "onboarding@resend.dev" works for testing (it can only email your own Resend account address);
# verify your domain in Resend to send from e.g. "Wildfern <hello@yourdomain.com>".
EMAIL_FROM=Wildfern <onboarding@resend.dev>
# Also send guests a confirmation email with their pass link (needs a verified domain).
SEND_GUEST_EMAILS=false

# Only needed if the frontend is served from a different origin than the API (comma-separated).
CORS_ORIGINS=

# Frontend: only needed if the API lives on a different origin.
VITE_API_URL=
